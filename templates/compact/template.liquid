<div class="top">
<div><h1 class="name">{{ fullName }}</h1><div class="headline">{{ headline }}</div></div>
<div class="contact">{% if location %}<div>{{ location }}</div>{% endif %}<div>{{ email }}{% if phone %} · {{ phone }}{% endif %}</div>{% if linkedin %}<div><a href="{{ linkedin }}">{{ linkedinLabel }}</a></div>{% endif %}</div>
</div>
{%- if summary != "" %}
<div class="h">Summary</div>
{%- if summaryIsList %}<ul class="summary-list">{% for l in summaryLines %}<li>{{ l }}</li>{% endfor %}</ul>{% else %}<p class="summary">{{ summary }}</p>{% endif %}
{%- endif %}
{%- if positions.size > 0 %}
<div class="h">Experience</div>
{%- for p in positions %}
<div class="job">
<div class="job-head"><span class="job-title">{{ p.title }}</span>, <span class="job-company">{{ p.company }}{% if p.location %}, {{ p.location }}{% endif %}</span><span class="job-dates"> · {{ p.dates }}</span></div>
{%- if p.bullets.size > 0 %}<ul>{% for b in p.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>{% endif %}
</div>
{%- endfor %}
{%- endif %}
{%- if skills.size > 0 %}
<div class="h">{{ skillsHeading }}</div>
<p class="inline">{% for s in skills %}{{ s.name }}{% unless forloop.last %} · {% endunless %}{% endfor %}</p>
{%- endif %}
{%- if education.size > 0 %}
<div class="h">Education</div>
{%- for e in education %}<div class="row"><span><strong>{{ e.degree }}</strong>, {{ e.institution }}</span>{% if e.years != "" %}<span class="sub">{{ e.years }}</span>{% endif %}</div>{% endfor %}
{%- endif %}
{%- for g in courseGroups %}
<div class="h">{{ g.provider }}</div>
{%- for c in g.items %}<div class="row"><span>{{ c.name }}</span>{% if c.term %}<span class="sub">{{ c.term }}</span>{% endif %}</div>{% endfor %}
{%- endfor %}
{%- if languages.size > 0 %}
<div class="h">Languages</div>
<p class="inline">{{ languagesText }}</p>
{%- endif %}
