<div class="cv">
<main class="main">
<h1 class="name">{{ fullName }}</h1>
<div class="headline">{{ headline }}</div>
{%- if summary != "" %}
<div class="h">Summary</div>
{%- if summaryIsList %}<ul class="summary-list">{% for l in summaryLines %}<li>{{ l }}</li>{% endfor %}</ul>{% else %}<p class="summary">{{ summary }}</p>{% endif %}
{%- endif %}
{%- if positions.size > 0 %}
<div class="h">Experience</div>
{%- for p in positions %}
<div class="job">
<div class="job-head"><span class="job-title">{{ p.title }}</span><span class="job-dates">{{ p.dates }}</span></div>
<div class="job-company">{{ p.company }}{% if p.location %}, {{ p.location }}{% endif %}</div>
{%- if p.bullets.size > 0 %}<ul>{% for b in p.bullets %}<li>{{ b.text }}</li>{% endfor %}</ul>{% endif %}
</div>
{%- endfor %}
{%- endif %}
</main>
<aside class="side">
<div class="h">Contact</div>
<div class="contact">
{%- if location %}<div>{{ location }}</div>{% endif %}
<div>{{ email }}</div>
{%- if phone %}<div>{{ phone }}</div>{% endif %}
{%- if linkedin %}<div><a href="{{ linkedin }}">{% if linkedinPrefix %}<span class="nb">{{ linkedinPrefix }}</span>{% endif %}<span class="{% if linkedinHandle.size > 24 %}long{% else %}nb{% endif %}">{{ linkedinHandle }}</span></a></div>{% endif %}
</div>
{%- if skills.size > 0 %}
<div class="h">{{ skillsHeading }}</div>
<ul>{% for s in skills %}<li>{{ s.name }}</li>{% endfor %}</ul>
{%- endif %}
{%- if education.size > 0 %}
<div class="h">Education</div>
{%- for e in education %}<div class="edu"><div class="edu-name">{{ e.degree }}</div><div class="sub">{{ e.institution }}{% if e.years != "" %}, {{ e.years }}{% endif %}</div></div>{% endfor %}
{%- endif %}
{%- for g in courseGroups %}
<div class="h">{{ g.provider }}</div>
{%- for c in g.items %}<div class="course"><div class="course-name">{{ c.name }}</div>{% if c.term %}<div class="sub">{{ c.term }}</div>{% endif %}</div>{% endfor %}
{%- endfor %}
{%- if languages.size > 0 %}
<div class="h">Languages</div>
<div>{{ languagesText }}</div>
{%- endif %}
</aside>
</div>
