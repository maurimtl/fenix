{
  "permissions": {
    "deny": [
      "Bash(git clean:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "_root=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$_root/.claude/hooks/check-data-on-stop.sh\" ] || _root=\"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\"; export CLAUDE_PROJECT_DIR=\"$_root\"; \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-data-on-stop.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "_root=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$_root/.claude/hooks/check-data-on-stop.sh\" ] || _root=\"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\"; export CLAUDE_PROJECT_DIR=\"$_root\"; \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false
}
